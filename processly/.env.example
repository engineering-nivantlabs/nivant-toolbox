# --- required ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:processly@localhost:5432/processly
ADMIN_TOKEN=change-me-to-a-long-random-string     # Bearer token for /api/*
HOOK_SECRET=change-me-to-another-long-random-string # signs webhooks, approval + upload links
PUBLIC_URL=https://engine.yourdomain.com          # used in approval and upload links
CONFIG_DIR=./templates                              # the client project directory
# FILES_DIR=./data/files
# DATA_DATABASE_URL=                                # business DB for data.query (defaults to DATABASE_URL)
# TZ=UTC                                            # business.yaml timezone wins if set

# --- Claude (AI steps) --------------------------------------------------------
ANTHROPIC_API_KEY=
# PROCESSLY_MODEL=claude-opus-5

# --- Email --------------------------------------------------------------------
SMTP_URL=smtps://user:password@smtp.yourprovider.com:465
EMAIL_FROM="Your Business <hello@yourdomain.com>"
# Inbound (trigger.email): any IMAP mailbox
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# IMAP_PORT=993
# IMAP_POLL_MS=30000

# --- WhatsApp Business Cloud API -------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=          # verifies inbound webhooks
WHATSAPP_VERIFY_TOKEN=        # any string; paste the same into Meta's webhook setup

# --- CRM / calendar / team ------------------------------------------------------
CRM_PROVIDER=internal         # internal | hubspot
HUBSPOT_TOKEN=
CALENDAR_PROVIDER=internal    # internal | google
GOOGLE_SERVICE_ACCOUNT_JSON=  # the whole JSON key, one line
SLACK_WEBHOOK_URL=

# --- Stripe webhooks (trigger.api via /hooks/stripe) ------------------------------
STRIPE_WEBHOOK_SECRET=

# --- Connection secrets referenced from connections.yaml as ${NAME} ---------------
STRIPE_SECRET_KEY=
# ACCOUNTING_API_URL= ACCOUNTING_API_TOKEN= CLINIC_API_URL= CLINIC_API_TOKEN= ...
